const resolveIcon = (iconOrName, name) => {
  const k = String(iconOrName || '').toLowerCase().trim();
  if (LUCIDE_TO_EMOJI[k]) return LUCIDE_TO_EMOJI[k];
  if (typeof iconOrName === 'string' && iconOrName.length > 0 && iconOrName.length <= 4) {
    return iconOrName;
  }
  return iconFor(name);
};

