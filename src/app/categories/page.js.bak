'use client';
import { useState, useEffect, useMemo } from 'react';
import { useRouter } from 'next/navigation';
import Link from 'next/link';
import { supabase } from '@/lib/supabase';
import { SkeletonList } from '@/components/Skeleton';
import EmptyState from '@/components/EmptyState';

export default function CategoriesPage() {
  const router = useRouter();
  const [categories, setCategories] = useState([]);
  const [loading, setLoading] = useState(true);
  const [search, setSearch] = useState('');

  useEffect(() => { load(); }, []);

  async function load() {
    if (!supabase) { setLoading(false); return; }
    try {
      const { data } = await supabase.from('service_categories').select('*').eq('is_active', true).eq('is_visible', true).order('sort_order');
      setCategories(data || []);
    } catch (e) { console.error(e); }
    setLoading(false);
  }

  const filtered = useMemo(() => {
    if (!search.trim()) return categories;
    const q = search.trim().toLowerCase();
    return categories.filter(c => (c.name || '').toLowerCase().includes(q));
  }, [categories, search]);

  if (loading) return <div style={{ padding: 16, background: '#f8fafc', minHeight: '100vh' }}><SkeletonList count={4} /></div>;

  return (
    <div style={{ minHeight: '100vh', background: '#f8fafc', paddingBottom: 80 }}>
      {/* Header */}
      <div style={{ position: 'sticky', top: 0, zIndex: 10, background: '#0f4d3a', padding: '14px 16px', display: 'flex', alignItems: 'center', gap: 12 }}>
        <button onClick={() => router.back()} style={{ background: 'rgba(255,255,255,.15)', color: '#fff', border: 'none', width: 40, height: 40, borderRadius: '50%', fontSize: 18, cursor: 'pointer', fontFamily: 'inherit' }}>→</button>
        <div style={{ flex: 1, color: '#fff', fontSize: 16, fontWeight: 900 }}>🎯 جميع الأقسام</div>
      </div>

      {/* Search */}
      <div style={{ padding: 16 }}>
        <input type="text" placeholder="🔍 ابحث عن قسم..." value={search} onChange={(e) => setSearch(e.target.value)}
          style={{ width: '100%', padding: '12px 14px', border: '1px solid #e5e7eb', borderRadius: 12, fontSize: 13, fontFamily: 'inherit', boxSizing: 'border-box', outline: 'none', background: '#fff' }} />
      </div>

      {/* Grid */}
      <div style={{ padding: '0 16px' }}>
        {filtered.length === 0 ? (
          <EmptyState icon="🎯" title={search ? 'لا توجد نتائج' : 'لا توجد أقسام'} actionLabel="← الرئيسية" actionHref="/" />
        ) : (
          <div style={{ display: 'grid', gridTemplateColumns: 'repeat(auto-fill, minmax(100px, 1fr))', gap: 12 }}>
            {filtered.map(c => (
              <Link key={c.id} href={`/search?q=${encodeURIComponent(c.name)}`} style={{ background: '#fff', border: '1px solid #e5e7eb', borderRadius: 16, padding: '16px 8px', textAlign: 'center', textDecoration: 'none', color: 'inherit', display: 'flex', flexDirection: 'column', alignItems: 'center', gap: 8, boxShadow: '0 2px 8px rgba(0,0,0,.02)' }}>
                <div style={{ fontSize: 32 }}>{c.icon || '📦'}</div>
                <div style={{ fontSize: 11, fontWeight: 900, color: '#334155', lineHeight: 1.4 }}>{c.name}</div>
              </Link>
            ))}
          </div>
        )}
      </div>
    </div>
  );
}

	
