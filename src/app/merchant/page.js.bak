'use client';

import { useState, useEffect } from 'react';
import { useRouter } from 'next/navigation';
import Link from 'next/link';
import { supabase } from '@/lib/supabase';

const iconFor = (v = '') => {
  const s = String(v).toLowerCase();
  if (/food|restaurant|مطعم|طعام/.test(s)) return '🍽️';
  if (/shop|store|متجر|سوق|بقالة/.test(s)) return '🏪';
  if (/health|clinic|صحة|طبي|عياد|صيدل|أسنان/.test(s)) return '❤️';
  if (/edu|school|تعليم|مدرس|مدرسة/.test(s)) return '🎓';
  if (/transport|نقل|سيار|توصيل/.test(s)) return '🚚';
  if (/home|منزل|كهرب|سباك|صيانة/.test(s)) return '🏠';
  if (/craft|حرف|مهن|نجار|باطون|لياسة/.test(s)) return '🛠️';
  if (/mosque|جامع|مسجد/.test(s)) return '🕌';
  if (/charity|خير|تبرع|جمعية/.test(s)) return '🎁';
  return '✦';
};

const TYPE_LABELS = {
  merchant: 'متجر',
  doctor: 'طبيب',
  school: 'مدرسة',
  mosque: 'جامع',
  municipality: 'بلدية',
  charity: 'جمعية خيرية',
};

export default function MerchantDashboard() {
  const router = useRouter();
  const [entity, setEntity] = useState(null);
  const [services, setServices] = useState([]);
  const [loading, setLoading] = useState(true);

  useEffect(() => {
    let stored = null;
    try {
      const raw = localStorage.getItem('sanad_entity');
      if (raw) stored = JSON.parse(raw);
    } catch {}

    if (!stored) {
      router.replace('/login');
      return;
    }
    setEntity(stored);
    loadServices(stored);
  }, [router]);

  async function loadServices(ent) {
    if (!supabase) { setLoading(false); return; }
    try {
      const { data } = await supabase
        .from('services')
        .select('*')
        .eq('provider_name', ent.display_name)
        .order('created_at', { ascending: false });
      if (Array.isArray(data)) setServices(data);
    } catch (e) {
      console.error(e);
    } finally {
      setLoading(false);
    }
  }

  function handleLogout() {
    try { localStorage.removeItem('sanad_entity'); } catch {}
    router.push('/');
  }

  if (!entity) {
    return (
      <div className="merchant-page">
        <div className="merchant-empty" style={{ margin: 60 }}>
          <span className="em">⏳</span>
          <h3>جارٍ التحميل...</h3>
        </div>
      </div>
    );
  }

  return (
    <div className="merchant-page">

      <header className="merchant-header">
        <div className="merchant-header-inner">
          <div className="merchant-toprow">
            <span className="merchant-greeting">لوحة التحكم</span>
            <button className="merchant-logout" onClick={handleLogout} aria-label="خروج">
              ⏻
            </button>
          </div>

          <div className="merchant-identity">
            <div className="merchant-logo">🏪</div>
            <div>
              <h1 className="merchant-name">{entity.display_name}</h1>
              <span className="merchant-type">
                {TYPE_LABELS[entity.entity_type] || entity.entity_type}
              </span>
            </div>
          </div>
        </div>
      </header>

      <div className="merchant-body">

        <div className="merchant-stats">
          <div className="merchant-stat">
            <div className="merchant-stat-val">{services.length}</div>
            <div className="merchant-stat-lab">خدمة</div>
          </div>
          <div className="merchant-stat">
            <div className="merchant-stat-val">0</div>
            <div className="merchant-stat-lab">مشاهدة</div>
          </div>
          <div className="merchant-stat">
            <div className="merchant-stat-val">0</div>
            <div className="merchant-stat-lab">طلب</div>
          </div>
        </div>

        <div className="merchant-actions">
          <Link href="/merchant/services/new" className="merchant-action primary">
            <div className="merchant-action-icon">+</div>
            <div>
              <div className="merchant-action-title">إضافة خدمة جديدة</div>
              <div className="merchant-action-desc">أضف خدماتك ليتم عرضها للزوار</div>
            </div>
          </Link>

          <Link href="/merchant/profile" className="merchant-action">
            <div className="merchant-action-icon">👤</div>
            <div className="merchant-action-title">الملف الشخصي</div>
            <div className="merchant-action-desc">تعديل بياناتك</div>
          </Link>

          <Link href="/merchant/settings" className="merchant-action">
            <div className="merchant-action-icon">⚙️</div>
            <div className="merchant-action-title">الإعدادات</div>
            <div className="merchant-action-desc">الأمان والإشعارات</div>
          </Link>
        </div>

        <div className="merchant-services">
          <div className="merchant-services-head">
            <h2 className="merchant-services-title">خدماتي</h2>
            <span className="merchant-services-count">{services.length} خدمة</span>
          </div>

          {loading ? (
            <div className="merchant-empty">
              <span className="em">⏳</span>
              <h3>جارٍ التحميل...</h3>
            </div>
          ) : services.length === 0 ? (
            <div className="merchant-empty">
              <span className="em">📦</span>
              <h3>لا توجد خدمات بعد</h3>
              <p>أضف خدمتك الأولى ليبدأ الزوار برؤيتها</p>
              <Link href="/merchant/services/new" className="merchant-empty-btn">
                + إضافة خدمة
              </Link>
            </div>
          ) : (
            services.map((s) => (
              <div key={s.id} className="merchant-service-item">
                <div className="merchant-service-icon">{iconFor(s.title)}</div>
                <div className="merchant-service-info">
                  <div className="merchant-service-name">{s.title}</div>
                  <div className="merchant-service-meta">
                    {s.is_featured && <span className="badge-feat">⭐ مميز</span>}
                    <span className="badge-cat">{s.status || 'نشط'}</span>
                  </div>
                </div>
              </div>
            ))
          )}
        </div>

        <Link
          href="/"
          style={{
            display: 'block',
            textAlign: 'center',
            padding: '14px',
            color: 'var(--f-700)',
            fontWeight: 800,
            fontSize: 13.5,
            marginTop: 20,
          }}
        >
          → العودة للموقع الرئيسي
        </Link>
      </div>
    </div>
  );
}
